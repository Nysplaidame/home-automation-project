# VentSys HA Scripts — Mode Execution
# Place in config/packages/ alongside ventsys_ha_package.yaml
#
# These scripts are called by the dashboard (ventilation_v9k.html) when a
# mode button is pressed. The dashboard handles local UI animation instantly;
# the script handles actual hardware via MQTT publish to the physical devices.
#
# MQTT topic schema (must match firmware and HA package):
#   ventsys/fan/control           → "on" / "off"   (main inline fan)
#   ventsys/fan/percent           → "0"–"100"       (main fan speed)
#   ventsys/spray-fan/control     → "on" / "off"   (spray booth fan)
#   ventsys/spray-fan/percent     → "0"–"100"       (spray fan speed)
#   ventsys/main/valve1/control   → "0"–"100"       (main duct valve 1)
#   ventsys/main/valve2/control   → "0"–"100"       (main duct valve 2)
#   ventsys/fdm/branch/control    → "0"–"100"       (ENC01 branch valve)
#   ventsys/fdm/valve/control     → "0"–"100"       (ENC01 print valve)
#   ventsys/fdm/360/control       → "0"–"100"       (ENC01 360° intake)
#   ventsys/sla/branch/control    → "0"–"100"       (ENC02 branch valve)
#   ventsys/sla/valve/control     → "0"–"100"       (ENC02 print valve)
#   ventsys/sla/360/control       → "0"–"100"       (ENC02 360° intake)

script:

  # ── SEAL ALL: everything closed, both fans off ────────────────────────
  # SAFETY NOTE (D2): This script explicitly sets ALL 10 actuator paths to
  # a known closed/off state. Call this first whenever switching between
  # single-subsystem modes to guarantee a clean hardware transition.
  ventsys_mode_sealed:
    alias: VentSys Mode — Seal All
    icon: mdi:lock-outline
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "off" }
      - action: mqtt.publish
        data: { topic: "ventsys/spray-fan/control", payload: "off" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve2/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "0" }

  # ── FIRE-SAFE VENTILATION: main fan + all enc paths, spray fan OFF ────
  # D1 fix: replaces the previous behaviour of calling ventsys_mode_purge
  # during a fire event. ventsys_mode_purge activated the SPRAY BOOTH FAN,
  # which is physically mounted at the spray booth extraction point — running
  # it across a fire accelerates combustion and spreads flames. This script:
  #   ✓ Turns on the main inline fan (exhausts fumes away from the enclosures)
  #   ✓ Opens all FDM and SLA paths fully (maximum enclosure extraction)
  #   ✓ Closes the spray booth path (main-2=0) to contain the fire event
  #   ✗ Does NOT activate the spray booth fan
  # This is the correct script to call from the fail-safe automation.
  ventsys_mode_fire_safe:
    alias: VentSys Mode — Fire-Safe Ventilation
    icon: mdi:fire-alert
    sequence:
      # Main inline fan on — exhausts fumes/smoke from enclosures
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }
      # Spray booth fan MUST stay off during a fire event
      - action: mqtt.publish
        data: { topic: "ventsys/spray-fan/control", payload: "off" }
      # Open all FDM enclosure paths fully
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "100" }
      # Open all SLA enclosure paths fully
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "100" }
      # Open main-1 to allow full enclosure extraction
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      # Close spray booth path — isolates booth from fire event
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve2/control", payload: "0" }

  # ── PURGE ALL: everything open, both fans on ──────────────────────────
  # WARNING: Do NOT use this as a fire response — the spray booth fan runs
  # across fire. Use ventsys_mode_fire_safe for fire events. Purge is intended
  # for post-event clearance only, when no active fire is present.
  ventsys_mode_purge:
    alias: VentSys Mode — Purge All
    icon: mdi:weather-windy
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }
      - action: mqtt.publish
        data: { topic: "ventsys/spray-fan/control", payload: "on" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve2/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "100" }

  # ── BOOTH: main-1 + main-2 open, spray fan on, main fan on ───────────
  # Enclosure paths (FDM/SLA branch valves, print valves, 360° intakes) are
  # intentionally NOT touched here. The system is extraction-only — air only
  # travels outward, so the booth path cannot cause ingress into the enclosures.
  # If an enclosure mode is active concurrently, it continues unaffected.
  ventsys_mode_booth:
    alias: VentSys Mode — Spray Booth
    icon: mdi:spray
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve2/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/spray-fan/control", payload: "on" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/percent", payload: "50" }

  # ── BOOTH SEAL: main-2 closed, spray fan off ─────────────────────────
  # Closes the spray booth extraction path and stops the booth fan.
  # main-1 is intentionally left as-is — if an enclosure mode (FDM/SLA) is
  # active it uses main-1 and should not be interrupted by sealing the booth.
  # Enclosure branch valves are also left untouched for the same reason.
  ventsys_mode_booth_seal:
    alias: VentSys Mode — Booth Seal
    icon: mdi:spray-bottle
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve2/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/spray-fan/control", payload: "off" }

  # ── FDM PRINT: enc1 print=100, enc1-branch=100, enc1-360=0, fan on ───
  ventsys_mode_fdm_print:
    alias: VentSys Mode — FDM Print
    icon: mdi:printer-3d
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── FDM ENCLOSURE: enc1-360=100, enc1-branch=100, enc1-print=0, fan on
  ventsys_mode_fdm_enclosure:
    alias: VentSys Mode — FDM Enclosure
    icon: mdi:cube-outline
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── FDM PURGE: enc1-360=100, enc1-print=100, enc1-branch=100, fan on ─
  ventsys_mode_fdm_purge:
    alias: VentSys Mode — FDM Purge
    icon: mdi:weather-windy
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── FDM SEAL: enc1 branch=0, enc1 print=0, enc1-360=0 ────────────────
  ventsys_mode_fdm_seal:
    alias: VentSys Mode — FDM Seal
    icon: mdi:lock
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/branch/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fdm/360/control", payload: "0" }

  # ── SLA PRINT: enc2-print=100, enc2-branch=100, main-1=100, 360=0 ────
  ventsys_mode_sla_print:
    alias: VentSys Mode — SLA Print
    icon: mdi:printer-3d-nozzle
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── SLA ENCLOSURE: enc2-360=100, enc2-branch=100, main-1=100, print=0
  ventsys_mode_sla_enclosure:
    alias: VentSys Mode — SLA Enclosure
    icon: mdi:cube-outline
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── SLA PURGE: enc2-360=100, enc2-print=100, enc2-branch=100, main-1=100
  ventsys_mode_sla_purge:
    alias: VentSys Mode — SLA Purge
    icon: mdi:weather-windy
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/main/valve1/control", payload: "100" }
      - action: mqtt.publish
        data: { topic: "ventsys/fan/control", payload: "on" }

  # ── SLA SEAL: enc2 branch=0, enc2 print=0, enc2-360=0 ────────────────
  ventsys_mode_sla_seal:
    alias: VentSys Mode — SLA Seal
    icon: mdi:lock
    sequence:
      - action: mqtt.publish
        data: { topic: "ventsys/sla/branch/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/valve/control", payload: "0" }
      - action: mqtt.publish
        data: { topic: "ventsys/sla/360/control", payload: "0" }
