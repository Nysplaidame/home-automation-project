      "targets": [
        { "datasource": { "type": "influxdb", "uid": "influxdb-homeassistant" }, "query": "from(bucket: \"homeassistant\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"syslog\" and r._field == \"message\" and (r.severity == \"warning\" or r.severity == \"err\" or r.severity == \"crit\" or r.severity == \"alert\" or r.severity == \"emerg\")) |> keep(columns: [\"_time\", \"_value\", \"appname\", \"facility\", \"severity\"])", "refId": "A" }
