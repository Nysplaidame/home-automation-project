[Unit]
Description=Proxmox and guest resource pressure alert monitor
After=network-online.target
Wants=network-online.target
OnFailure=resource-pressure-monitor-failure.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/resource-pressure-monitor.py
TimeoutStartSec=55
StateDirectory=resource-pressure-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/resource-pressure-monitor /run /etc/pve
