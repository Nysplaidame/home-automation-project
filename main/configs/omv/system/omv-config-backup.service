[Unit]
Description=Back up OMV configuration and export evidence to Media mirror
After=local-fs.target nfs-server.service
RequiresMountsFor=/srv/dev-disk-by-uuid-a8843f98-c937-48a8-aefa-4cd0fb80667c/backups/configs

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/omv-config-backup
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/dev-disk-by-uuid-a8843f98-c937-48a8-aefa-4cd0fb80667c/backups/configs/omv-config

