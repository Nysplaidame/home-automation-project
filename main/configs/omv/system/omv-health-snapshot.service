[Unit]
Description=Produce private OMV host-local health snapshot
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=omv-metrics
UMask=0077
ExecStart=/usr/bin/python3 -B /usr/local/libexec/home-automation/omv-health-publish.py
StateDirectory=home-automation/omv-health
StateDirectoryMode=0750
TimeoutStartSec=15min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
DevicePolicy=closed
# Reviewed current SATA devices only. Reconcile names at deployment; no wildcard.
# Some SMART ioctls require rw opens; immutable source is the command boundary.
DeviceAllow=/dev/sda rw
DeviceAllow=/dev/sdb rw
DeviceAllow=/dev/sdc rw
DeviceAllow=/dev/sdd rw
DeviceAllow=/dev/sde rw
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_DAC_READ_SEARCH CAP_CHOWN

