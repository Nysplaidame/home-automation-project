[Unit]
Description=Household Hub coordinated cold checkpoint
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/omv/docker-host-backups

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/household-hub-coordinated-backup.py --execute
# Allow cleanup to resume originals on TERM. Never forcibly kill it mid-resume.
TimeoutStartSec=infinity
TimeoutStopSec=5min
SendSIGKILL=no
