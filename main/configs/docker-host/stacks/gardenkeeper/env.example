POSTGRES_DB=gardenkeeper
POSTGRES_USER=gardenkeeper
POSTGRES_PASSWORD=replace-with-generated-password

GARDENKEEPER_ENV=production
GARDENKEEPER_API_HOST=0.0.0.0
GARDENKEEPER_API_PORT=8090
AUTO_RUN_MIGRATIONS=true
AUTO_CREATE_TABLES=false

DATABASE_URL=postgresql+asyncpg://gardenkeeper:replace-with-generated-password@postgres:5432/gardenkeeper
REDIS_URL=redis://redis:6379/0
GARDENKEEPER_API_URL=http://api:8090
WORKER_POLL_SECONDS=60
WORKER_REQUEST_TIMEOUT_SECONDS=10
WORKER_GENERATE_CARE_TASKS=true

OLLAMA_BASE_URL=http://192.168.20.104:11434
OLLAMA_MODEL=home-assistant-llm

GARDENKEEPER_NOTIFICATION_BROKER_URL=
GARDENKEEPER_NOTIFICATION_BROKER_TOKEN=
GARDENKEEPER_NOTIFICATION_SOURCE=gardenkeeper
NTFY_TOPIC_DIGEST=gardenkeeper-digest
NTFY_TOPIC_URGENT=gardenkeeper-urgent
NTFY_TOPIC_MAINTENANCE=gardenkeeper-maintenance

HOME_ASSISTANT_BASE_URL=http://192.168.20.101:8123
HOME_ASSISTANT_WEBHOOK_SECRET=

KNOWLEDGE_HUB_URL=
SEARXNG_URL=http://searxng.home.local:8087
MEALIE_URL=http://mealie.home.local:9925
MEALIE_API_TOKEN=
GROCY_URL=http://grocy.home.local:9283
GROCY_API_KEY=
NEXTCLOUD_CALDAV_URL=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_PROJECTION_LOOKAHEAD_DAYS=30
