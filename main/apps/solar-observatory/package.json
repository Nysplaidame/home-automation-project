{
  "name": "solar-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "stage:data": "node --experimental-strip-types scripts/stage-data.ts",
    "dev": "npm run stage:data && vite --host 127.0.0.1 --port 4175",
    "build": "npm run stage:data && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "test:browser": "playwright test",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "capture:fixtures": "node --experimental-strip-types scripts/capture-fixtures.ts",
    "refresh": "node --experimental-strip-types scripts/refresh.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
