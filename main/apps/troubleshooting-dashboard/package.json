{
  "name": "home-automation-troubleshooting-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check app.js && node --check diagnostic-model.js && node --check additional-routes.js && node --check live-tools.js && npm test",
    "test:api": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:live": "node tests/live-tools-smoke.mjs",
    "test:extensions": "node tests/extension-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  }
}
