flowchart TB
    Internet["Internet"]
    Router["router<br/>OpenWrt L3 gateway .1 on each VLAN<br/>DHCP, local DNS, firewall, NTP"]
    Internet -->|"WAN DHCP"| Router

    subgraph V1["VLAN 1: HomeMain LAN | 192.168.1.0/24"]
        LANClients["Phones, laptops, tablets<br/>HomeMain 2.4/5 GHz SSID<br/>router: 192.168.1.1"]
        Recovery["lan5: unconnected; reserved<br/>LAN/recovery laptop"]
    end

    subgraph V10["VLAN 10: Management | 192.168.10.0/24"]
        Proxmox["proxmox<br/>192.168.10.10:8006,22<br/>proxmox.home.local"]
        RouterAdmin["HomeAdmin 5 GHz / HomeAdmin-2G hidden SSID<br/>lan2 and lan4: unconnected temporary/admin access"]
        RollbackFrigate["VM 101 frigate-nvr<br/>powered off; rollback only"]
        RollbackLLM["VM 104 llm-host<br/>powered off; rollback only"]
    end

    subgraph V20["VLAN 20: Automation | 192.168.20.0/24"]
        HA["home-assistant (VM 100)<br/>192.168.20.101:8123 HTTPS<br/>homeassistant.home.local<br/>Mosquitto TLS 8883, ESPHome, Assist"]
        subgraph DockerApps["docker-host (VM 103) | 192.168.20.102 | docker-host.home.local"]
            direction TB
            DockerHost["Docker Engine + Tailscale subnet router<br/>SSH 22"]
            AdGuard["AdGuard Home<br/>53 TCP/UDP; admin 8080<br/>adguard.home.local"]
            Immich["Immich<br/>2283; immich.home.local"]
            Homepage["Homepage<br/>3001; homepage.home.local"]
            Dozzle["Dozzle<br/>8081; dozzle.home.local"]
            Mermaid["Mermaid Viewer<br/>8092; mermaid-viewer.home.local"]
            Bambuddy["Bambuddy<br/>8000; bambuddy.home.local"]
            Ntfy["ntfy<br/>8085; ntfy.home.local"]
            Mealie["Mealie<br/>9925; mealie.home.local:9925"]
            Grocy["Grocy<br/>9283; grocy.home.local:9283"]
            Obsidian["Obsidian LiveSync / CouchDB<br/>5984; obsidian-sync.home.local:5984<br/>Tailscale Serve HTTPS 8443"]
            Garden["GardenKeeper<br/>UI 8091 / API 8090<br/>gardenkeeper.home.local:8091"]
            SearXNG["SearXNG<br/>8087; internal-only"]
            Whoogle["Whoogle<br/>8088; internal-only"]
            Watchtower["Watchtower<br/>monitor-only; no published port"]
            Telegraf["Docker-host Telegraf<br/>metrics to InfluxDB 8086"]
            DockerHost --- AdGuard
            DockerHost --- Immich
            DockerHost --- Homepage
            DockerHost --- Dozzle
            DockerHost --- Mermaid
            DockerHost --- Bambuddy
            DockerHost --- Ntfy
            DockerHost --- Mealie
            DockerHost --- Grocy
            DockerHost --- Obsidian
            DockerHost --- Garden
            DockerHost --- SearXNG
            DockerHost --- Whoogle
            DockerHost --- Watchtower
            DockerHost --- Telegraf
        end
        LLM["llm-host (CT 114)<br/>192.168.20.104<br/>llm-host.home.local"]
        LlamaChat["llama.cpp chat<br/>8081/v1"]
        Embeddings["llama.cpp embeddings<br/>8082/v1"]
        OpenWebUI["Open WebUI<br/>3002<br/>openwebui.home.local"]
        Voice["Wyoming Whisper 10200<br/>Piper 10300<br/>OpenWakeWord 10400"]
        HA -->|"LLM 8081; voice services"| LLM
        LLM --- LlamaChat
        LLM --- Embeddings
        LLM --- OpenWebUI
        LLM --- Voice
    end

    subgraph V30["VLAN 30: NVR | 192.168.30.0/24 | no WAN"]
        Frigate["frigate-nvr (CT 111) / Frigate 0.17.1<br/>192.168.30.20<br/>frigate.home.local<br/>HTTPS UI 8971; HA API 5000; RTSP 8554; WebRTC 8555"]
        Camera1["cam-01-annke-c500<br/>192.168.30.21<br/>RTSP main 101 / sub 102"]
        CamerasFuture["cam-02 through cam-06<br/>future VLAN 30 cameras"]
        Camera1 -->|"RTSP"| Frigate
        CamerasFuture -.->|"future RTSP"| Frigate
    end

    subgraph V35["VLAN 35: Printers | 192.168.35.0/24"]
        P1S["p1s / Bambu Lab P1S<br/>192.168.35.200<br/>HomePrinters 2.4/5 GHz SSID"]
        Athena["Concepts3D Athena 2<br/>192.168.35.201 planned<br/>WiFi or future wired path"]
    end

    subgraph V40["VLAN 40: Storage | 192.168.40.0/24 | no WAN"]
        OMV["omvnas / OMV NAS<br/>192.168.40.50<br/>omv.home.local / nas.home.local<br/>80,22,445,NFS 2049; Transfer Portal 8088"]
    end

    subgraph V50["VLAN 50: HomeIoT | 192.168.50.0/24 | WiFi-only"]
        IoT["VentSys ESPHome, smart plugs, sensors<br/>HomeIoT 2.4 GHz SSID<br/>hardware adoption pending"]
    end

    subgraph V60["VLAN 60: Monitoring | 192.168.60.0/24"]
        Monitoring["monitoring (VM 102)<br/>192.168.60.10<br/>Grafana 3000; Uptime Kuma 3001; InfluxDB 8086"]
    end

    subgraph V70["VLAN 70: DMZ | 192.168.70.0/24"]
        DMZ["No live hosts<br/>HomeDMZ is configured but disabled"]
    end

    subgraph V99["VLAN 99: Guest | 192.168.99.0/24 | WiFi-only"]
        Guest["HomeGuest 2.4 GHz SSID<br/>internet only"]
    end

    Router -->|"routes and firewall policy"| Proxmox

    Proxmox --> HA
    Proxmox --> DockerHost
    Proxmox --> Frigate
    Proxmox --> LLM
    Proxmox --> Monitoring

    Bambuddy -->|"MQTT TLS"| P1S

    OMV -->|"NFS recordings"| Frigate
    OMV -->|"NFS backups"| HA
    OMV -->|"NFS media"| Immich
    DockerHost -->|"NFS app-data backups"| OMV
    Telegraf -->|"metrics to InfluxDB 8086"| Monitoring

    subgraph Remote["Remote access: Tailscale is daily; WireGuard is fallback"]
        Mobile["Android operator phone<br/>oneplus-9-pro<br/>100.105.216.6 observed 2026-07-10"]
        Tailnet["Tailscale encrypted overlay<br/>direct UDP when possible; current phone path relays via DERP London"]
        Tailscale["docker-host tailscale0<br/>100.94.122.18<br/>MagicDNS: docker-host.tail7012a0.ts.net<br/>--accept-dns=false"]
        ApprovedRoutes["Approved host routes<br/>192.168.20.101/32 HA<br/>192.168.40.50/32 OMV<br/>192.168.60.10/32 Grafana/Kuma"]
        PendingRoute["Advertised, pending Tailscale admin approval<br/>192.168.30.20/32 Frigate HTTPS 8971 only"]
        TailSetup["Setup on docker-host<br/>tailscale up --accept-dns=false --hostname=docker-host<br/>advertise only the four /32 host routes; IP forwarding enabled"]
        TailControls["Enforcement<br/>Tailscale ACLs + docker-host UFW route rules<br/>OpenWrt permits only required destination ports"]
        WireGuard["WireGuard on router<br/>dormant fallback"]
    end
    Mobile --> Tailnet --> Tailscale --> DockerHost
    Tailscale --> ApprovedRoutes
    Tailscale --> PendingRoute
    Tailscale -.-> TailSetup
    Tailscale -.-> TailControls
    DockerHost -->|"same VLAN 20; UFW route<br/>HTTPS 8123"| HA
    DockerHost -->|"cross-VLAN path"| Router
    ApprovedRoutes -->|"via docker-host then router where needed"| HA
    ApprovedRoutes --> OMV
    ApprovedRoutes --> Monitoring
    PendingRoute -.->|"after approval; router allows only 8971"| Frigate
    Router -.-> WireGuard

