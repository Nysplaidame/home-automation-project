flowchart LR
    Upstream["Openreach ONT<br/>Zen fibre"] --> WAN

    subgraph Router["GL-MT6000 OpenWrt · 192.168.10.1"]
        WAN["WAN eth1<br/>untagged PPPoE"]
        LAN1["lan1<br/>tagged Proxmox trunk"]
        LAN2["lan2<br/>Hive cloud IoT<br/>VLAN 55 untagged"]
        LAN3["lan3<br/>tagged switch trunk<br/>VLANs 1/10/30/40"]
        LAN4["lan4<br/>OMV NAS access<br/>VLAN 40 untagged"]
        LAN5["lan5<br/>LAN/recovery access"]
        WiFi["Wi-Fi<br/>HomeMain · HomeAdmin · HomePrinters<br/>HomeIoT · HomeGuest"]
    end

    LAN2 --> Hive["Hive hub<br/>192.168.55.10<br/>internet traffic verified; app issue open"]
    LAN1 --> Proxmox["MINISFORUM Proxmox host<br/>192.168.10.10<br/>VLAN-aware guest bridge"]
    LAN3 --> SW1

    subgraph Switch["Zyxel GS1900-8HP · 192.168.10.12 · currently unplugged"]
        SW1["Port 1<br/>router trunk"]
        SW2["Port 2<br/>PoE · VLAN 30 access"]
        SW3["Port 3<br/>PoE · VLAN 30 access"]
        SW4["Port 4<br/>PoE · VLAN 30 access"]
        SW57["Ports 5-7<br/>PoE · VLAN 30 access<br/>spare CCTV ports"]
        SW8["Port 8<br/>spare VLAN 40 access"]
    end

    SW2 --> Camera["ANNKE C500 cam-01<br/>192.168.30.21"]
    SW3 --> PatioCamera["Patio camera cam-03<br/>192.168.30.23"]
    SW4 --> GateCamera["Gate camera cam-02<br/>192.168.30.22"]
    SW57 -.-> FutureCameras["Future exterior cameras<br/>VLAN 30"]
    LAN4 --> OMV["OpenMediaVault NAS<br/>192.168.40.50"]
    WiFi --> Admin["Admin workstation<br/>HomeAdmin · VLAN 10"]
    WiFi --> Users["Household devices<br/>HomeMain · VLAN 1"]
    WiFi --> Printer["Bambu P1S<br/>HomePrinters · VLAN 35<br/>not yet set up"]
    WiFi -.-> VentSys["Future VentSys devices<br/>HomeIoT · VLAN 50"]

    Proxmox --> HA["VM 100 HA · VLAN 20"]
    Proxmox --> Monitor["VM 102 monitoring · VLAN 60"]
    Proxmox --> Docker["VM 103 docker-host · VLAN 20"]
    Proxmox --> Frigate["CT 111 Frigate · VLAN 30"]
    Proxmox --> LLM["CT 114 local AI · VLAN 20"]

