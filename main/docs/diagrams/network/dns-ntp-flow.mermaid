flowchart LR
    subgraph DNS["NAME RESOLUTION"]
        direction TB
        Clients["CLIENTS · INCLUDING RESTRICTED VLANS<br/>Use their router gateway for DNS"]
        RouterDNS["OPENWRT DNSMASQ<br/>Local names + DHCP authority"]
        AdGuard["ADGUARD · VM103<br/>192.168.20.102 · filtering"]
        Upstream["PUBLIC RESOLVERS<br/>Quad9 preferred · Cloudflare secondary<br/>No Google fallback"]
        Clients --> RouterDNS --> AdGuard --> Upstream
        RouterDNS -.->|"fallback if AdGuard unavailable"| Upstream
    end
    subgraph Time["TIME SYNCHRONIZATION"]
        direction TB
        NTP["OPENWRT NTP<br/>Per-zone scoped access"]
        HA["HOME ASSISTANT<br/>Router-derived time"]
        ESP["ESPHOME / VENTSYS<br/>Through HA or permitted direct NTP<br/>Hardware adoption remains pending"]
        NTP --> HA --> ESP
        NTP -.->|"where allowed"| ESP
    end
    subgraph Policy["CLIENT POLICY"]
        Rules["Router remains local-name authority<br/>Enforced clients cannot bypass DNS53/853<br/>VLAN55 Hive also uses router DNS/NTP<br/>Nonstandard encrypted DNS is not excluded"]
    end
    DNS ~~~ Time ~~~ Policy
    class RouterDNS,AdGuard,NTP,HA core
    class Rules policy
    class ESP deferred

    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef store fill:#292745,stroke:#aa99db,color:#f2edff
    classDef policy fill:#2f301f,stroke:#c7bc77,color:#fff9d8
    classDef deferred fill:#1b2638,stroke:#9dabc1,color:#d3dfef,stroke-dasharray:5 4
