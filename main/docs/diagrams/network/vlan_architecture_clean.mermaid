flowchart TB
    Router["OPENWRT SEGMENT MAP · 11 NETWORKS<br/>Every subnet is /24; router gateway is .1<br/>Membership does not imply inter-VLAN permission"]
    subgraph Trusted["PEOPLE + ADMINISTRATION"]
        direction TB
        V1["VLAN1 · LAN<br/>192.168.1.0/24<br/>HomeMain · LAN5 recovery"]
        V10["VLAN10 · MANAGEMENT<br/>192.168.10.0/24 · HomeAdmin<br/>Router .1 · Proxmox .10 · Zyxel .12"]
        V99["VLAN99 · GUEST<br/>192.168.99.0/24 · HomeGuest<br/>Internet only; no internal VLAN access"]
        V70["VLAN70 · DMZ<br/>192.168.70.0/24<br/>Reserved controlled public edge"]
        V1 ~~~ V10 ~~~ V99 ~~~ V70
    end
    subgraph Services["INFRASTRUCTURE SERVICES"]
        direction TB
        V20["VLAN20 · AUTOMATION<br/>192.168.20.0/24<br/>HA .101 · docker-host .102 · AI .104"]
        V30["VLAN30 · NVR<br/>192.168.30.0/24 · Frigate .20<br/>Cameras .21–.23 disconnected; .24 future"]
        V40["VLAN40 · STORAGE<br/>192.168.40.0/24<br/>OMV .50 · direct LAN4 access"]
        V60["VLAN60 · MONITORING<br/>192.168.60.0/24<br/>VM102 .10 · Kuma / Grafana / InfluxDB"]
        V20 ~~~ V30 ~~~ V40 ~~~ V60
    end
    subgraph Devices["PRINTERS + DEVICES"]
        direction TB
        V35["VLAN35 · PRINTERS<br/>192.168.35.0/24 · HomePrinters<br/>P1S .200 · not commissioned"]
        V50["VLAN50 · IOT SENSORS<br/>192.168.50.0/24 · HomeIoT<br/>VentSys hardware pending; no internet"]
        V55["VLAN55 · CLOUD IOT<br/>192.168.55.0/24 · LAN2<br/>Hive .10 · WAN only; app issue open"]
        V35 ~~~ V50 ~~~ V55
    end
    Router --- Trusted
    Router --- Services
    Router --- Devices
    class Router core
    class V70,V35,V50 deferred
    class V55 policy

    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef store fill:#292745,stroke:#aa99db,color:#f2edff
