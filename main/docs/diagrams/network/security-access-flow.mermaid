flowchart TB
    User["Trusted user devices<br/>VLAN 1"]
    Router["OpenWrt firewall<br/>zone policy and DHCP/DNS"]
    Mgmt["Management<br/>VLAN 10"]
    Automation["Automation<br/>VLAN 20"]
    NVR["NVR<br/>VLAN 30"]
    Printers["Printers<br/>VLAN 35"]
    Storage["Storage<br/>VLAN 40"]
    IoT["IoT sensors<br/>VLAN 50"]
    Monitoring["Monitoring<br/>VLAN 60"]
    DMZ["DMZ<br/>VLAN 70"]
    Guest["Guest<br/>VLAN 99"]
    TailAdmin["Tailscale admin paths<br/>four narrow /32 routes"]
    TailMobile["OnePlus portal grant<br/>DNS · 443 · 8180-8209"]
    PortalProxy["Homepage fixed-target proxy<br/>docker-host"]
    HostFW["Host firewalls / UFW<br/>Linux services"]
    ServiceAuth["Service auth<br/>HA 2FA, app logins, tokens"]
    LocalAI["llm-host CT 114<br/>llama.cpp + Wyoming<br/>approved HA entities only"]

    User --> Router
    Router --> Mgmt
    Router --> Automation
    Router --> NVR
    Router --> Printers
    Router --> Storage
    Router --> IoT
    Router --> Monitoring
    Router --> DMZ
    Router --> Guest

    TailAdmin --> Automation
    TailAdmin --> NVR
    TailAdmin --> Storage
    TailAdmin --> Monitoring
    TailMobile --> PortalProxy
    PortalProxy --> HostFW
    Automation --> HostFW
    Automation --> LocalAI
    Storage --> HostFW
    HostFW --> ServiceAuth
    LocalAI --> ServiceAuth

    Automation -.->|"MQTT / ESPHome only"| IoT
    NVR -.->|"recording/archive only"| Storage
    Automation -.->|"Bambuddy to P1S ports 21/8883 only"| Printers
    Monitoring -.->|"health checks and metrics only"| Automation
    Monitoring -.->|"AI service checks only"| LocalAI
    Monitoring -.->|"health checks and metrics only"| NVR
    Monitoring -.->|"health checks and metrics only"| Storage

    GuestX["Guest cannot reach internal VLANs"]
    IoTX["IoT cannot initiate broad access"]
    StorageX["Storage has no broad internet"]
    NVRX["NVR has no broad internet"]
    PrinterX["Printers limited to required OTA/cloud paths"]
    TailX["Mobile portal identity has no broad VLAN or SSH access"]

    Guest -.->|"blocked"| GuestX
    IoT -.->|"blocked"| IoTX
    Storage -.->|"blocked"| StorageX
    NVR -.->|"blocked"| NVRX
    Printers -.->|"limited"| PrinterX
    TailMobile -.->|"blocked"| TailX
