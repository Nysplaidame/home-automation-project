flowchart LR
    RemoteUser["Remote operator<br/>laptop or phone"]
    Tailnet["Tailscale tailnet<br/>daily remote layer"]
    DockerHost["docker-host VM 103<br/>Tailscale node<br/>192.168.20.102"]
    MobilePortal["OnePlus daily portal access<br/>split DNS · tcp/443 · tcp/8180-8209"]
    FixedProxy["Homepage fixed-target HTTPS proxy<br/>no arbitrary destination"]
    HA["Home Assistant<br/>192.168.20.101/32"]
    Frigate["Frigate HTTPS<br/>192.168.30.20/32"]
    OMV["OMV NAS<br/>192.168.40.50/32"]
    Monitoring["Grafana + Kuma<br/>192.168.60.10/32"]
    DockerServices["docker-host services<br/>MagicDNS / Tailscale identity"]
    Router["OpenWrt router<br/>WireGuard server"]
    WGClient["WireGuard client<br/>dormant fallback"]

    RemoteUser --> Tailnet
    Tailnet --> DockerHost
    DockerHost --> MobilePortal --> FixedProxy --> DockerServices
    DockerHost -.->|"advertised host route"| HA
    DockerHost -.->|"HTTPS 8971 host route"| Frigate
    DockerHost -.->|"advertised host route"| OMV
    DockerHost -.->|"ports 3000/3001 host route"| Monitoring

    RemoteUser -.->|"only if Tailscale unavailable"| WGClient
    WGClient -.->|"split tunnel fallback"| Router
    Router -.->|"limited fallback access"| HA
    Router -.->|"OMV host access only where needed"| OMV

    Blocked1["No broad VLAN 40 route"]
    Blocked2["No daily WireGuard dependency"]
    Blocked3["No direct public app exposure by default"]
    Blocked4["Mobile portal grant cannot use SSH,<br/>InfluxDB direct, or broad VLAN routes"]

    DockerHost -.->|"blocked by policy"| Blocked1
    Router -.->|"blocked by policy"| Blocked2
    DockerServices -.->|"blocked by policy"| Blocked3
    MobilePortal -.->|"blocked by policy"| Blocked4

    classDef allowed fill:#e8f7ee,stroke:#2f855a,stroke-width:1px
    classDef fallback fill:#fff7e6,stroke:#b7791f,stroke-width:1px
    classDef blocked fill:#ffe8e8,stroke:#c53030,stroke-width:1px

    class RemoteUser,Tailnet,DockerHost,MobilePortal,FixedProxy,HA,Frigate,OMV,Monitoring,DockerServices allowed
    class Router,WGClient fallback
    class Blocked1,Blocked2,Blocked3,Blocked4 blocked
