flowchart LR
    %% Applies to the legacy active FDM/SLA 360 intake valve YAML files; do not use for the unconfirmed v2 Nerdiy variants.
    %% Layout: power (left) --> ESP pins --- peripheral pins (right). Servo 5V comes straight from the PSU.
    PSU["Dedicated regulated 5V rail<br/>size for servo stall current"]
    subgraph ESP["ESP32DEV · 360° INTAKE VALVE CONTROLLER"]
        ESPVin["5V / VIN<br/>board power"]
        ESPGnd["GND"]
        ServoPin["GPIO4<br/>50 Hz servo PWM"]
        LedPin["GPIO21<br/>WS2812 status LED"]
        TouchPin["GPIO33<br/>Touch-toggle input"]
    end
    subgraph Servo["MG90S SERVO / 360° INTAKE VALVE"]
        ServoV["Red · 5V"]
        ServoGnd["Brown · GND"]
        ServoSignal["Orange · signal"]
    end
    subgraph Aux["ON-BOARD / OPTIONAL INPUTS"]
        Led["WS2812 status LED"]
        Touch["Touch pad"]
    end
    Note["GPIO4 is the active legacy assignment.<br/>Do not substitute the unconfirmed v2 GPIO0 configuration without a physical-build decision."]
    PSU --> ESPVin
    PSU --> ESPGnd
    PSU -->|servo 5V| ServoV
    ESPGnd --- ServoGnd
    ServoPin --- ServoSignal
    LedPin --- Led
    TouchPin --- Touch
    Note ~~~ PSU
    class ESP,Servo,Aux core
    class PSU,Note policy
    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef policy fill:#2f301f,stroke:#c7bc77,color:#fff9d8
