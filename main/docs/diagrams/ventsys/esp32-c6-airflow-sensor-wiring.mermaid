flowchart LR
    %% GPIO differs by active board configuration; source of truth: ventsys_*_airflow.yaml.
    %% Layout: ESP pins (left) --- peripheral pins (right) --- power (far right). Solid = FDM/SLA board, dashed = Booth board.
    Note["Choose only the GPIO pair matching the installed airflow board.<br/>Verify sensor supply and output before connection; level-shift outputs above 3.3V."]
    subgraph ESP["ESP32-C6 AIRFLOW-SENSOR FAMILY"]
        FdmPulse["FDM / SLA · GPIO0<br/>pulse input · inverted INPUT_PULLUP"]
        BoothPulse["Booth · GPIO10<br/>pulse input · inverted INPUT_PULLUP"]
        V33["3.3V rail"]
        GND["Common GND"]
        FdmLed["FDM / SLA · GPIO1<br/>WS2812 data"]
        BoothLed["Booth · GPIO9<br/>WS2812 data"]
    end
    subgraph Meter["AIRFLOW / PULSE SENSOR"]
        MeterOut["Pulse output"]
        MeterV["VCC · verify sensor voltage"]
        MeterG["GND"]
    end
    subgraph LEDs["WS2812 LED STRIP"]
        LedDin["DIN"]
        LedG["GND"]
        LedV["5V power"]
    end
    PSU["Regulated supply matched to LED and sensor ratings"]
    Note ~~~ ESP
    FdmPulse --- MeterOut
    BoothPulse -.- MeterOut
    PSU -. "sensor supply only if rated appropriately" .- MeterV
    GND --- MeterG
    GND --- LedG
    FdmLed --- LedDin
    BoothLed -.- LedDin
    LedV --- PSU
    class ESP,Meter,LEDs core
    class PSU,Note policy
    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef policy fill:#2f301f,stroke:#c7bc77,color:#fff9d8
