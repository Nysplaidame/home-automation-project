%%{init: {"theme":"base","fontFamily":"Segoe UI, sans-serif","themeVariables":{"primaryColor":"#123044","primaryTextColor":"#eef6ff","primaryBorderColor":"#58b7bf","lineColor":"#9aafc4","clusterBkg":"#0d1c2d","clusterBorder":"#38516b","tertiaryColor":"#0d1c2d","edgeLabelBackground":"#0b1929","fontFamily":"Segoe UI, sans-serif","fontSize":"18px"},"flowchart":{"curve":"linear","nodeSpacing":20,"rankSpacing":28,"padding":12,"subGraphTitleMargin":{"top":8,"bottom":16},"wrappingWidth":380,"useMaxWidth":false}}}%%
flowchart LR
    %% Design intent only; not a commissioned or certified safety system.
    subgraph Control["01 · CONTROL + TELEMETRY · PLANNED"]
        direction TB
        HA["HOME ASSISTANT VM100<br/>Reviewed automation authority"]
        MQTT["MOSQUITTO<br/>TLS8883 target · scoped topics"]
        Devices["VLAN50 DEVICE FLEET<br/>Temperature / humidity / VOC / smoke / pressure<br/>Fan / valve controllers · smart plugs"]
        ESP["ESPHOME ADD-ON<br/>Firmware, adoption and device configuration"]
        HA <-->|"commands / telemetry"| MQTT
        MQTT <--> Devices
        ESP -.->|"adoption"| Devices
    end
    subgraph Air["02 · PHYSICAL AIRFLOW · PLANNED"]
        direction TB
        Sources["FDM enclosure · SLA enclosure<br/>Spray booth"]
        Duct["PrintAirPipe ducting<br/>Branch / enclosure / 360° valves"]
        Exhaust["Inline / booth fans<br/>Window exhaust"]
        Sources --> Duct --> Exhaust
        Sensors["Sensors observe enclosures / duct<br/>Actuators operate fans and valves"]
        Exhaust ~~~ Sensors
    end
    subgraph Safety["03 · SAFETY ACCEPTANCE · HARDWARE GATE"]
        direction TB
        Trigger["Sensor threshold / reviewed HA trigger"]
        Emergency["Emergency sequence<br/>Printer power cutoff + fan / valve response"]
        Manual["Manual override + device failsafe defaults<br/>Verify network / HA loss and cold boot"]
        Acceptance["No commissioned safety claim yet<br/>Physical tests + independent acceptance<br/>No assistant or diagram can actuate devices"]
        Trigger --> Emergency
        Emergency ~~~ Manual ~~~ Acceptance
    end
    Control ~~~ Air ~~~ Safety
    class HA,MQTT core
    class Trigger,Emergency,Manual,Acceptance policy
    class Devices,ESP,Sources,Duct,Exhaust,Sensors deferred

    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef store fill:#292745,stroke:#aa99db,color:#f2edff
    classDef policy fill:#2f301f,stroke:#c7bc77,color:#fff9d8
    classDef deferred fill:#1b2638,stroke:#9dabc1,color:#d3dfef,stroke-dasharray:5 4
