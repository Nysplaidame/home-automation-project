flowchart LR
    %% Guest membership and backup jobs; no cross-links to application services.
    subgraph VMs["PROXMOX · PRODUCTION VMS"]
        direction TB
        HA["VM100 · HOME ASSISTANT<br/>.20.101 · 2 vCPU · 6 GiB RAM · 32 GiB disk"]
        Monitor["VM102 · MONITORING<br/>.60.10 · 2 vCPU · 3 GiB RAM · 32 GiB disk"]
        Docker["VM103 · DOCKER HOST<br/>.20.102 · 2 vCPU · 6 GiB RAM · 64 GiB disk"]
        HA ~~~ Monitor ~~~ Docker
    end
    subgraph CTs["PROXMOX · PRODUCTION LXCS"]
        direction TB
        Frigate["CT111 · FRIGATE<br/>.30.20 · 2 vCPU · 6 GiB RAM · 32 GiB disk"]
        AI["CT114 · LOCAL AI<br/>.20.104 · 4 vCPU · 20 GiB RAM · 100 GiB disk"]
        GPU["Shared Intel iGPU device access<br/>renderD128 + card0<br/>No PCI passthrough"]
        Frigate ~~~ AI ~~~ GPU
    end
    VMJob["VM JOB · 100 / 102 / 103<br/>Daily02:00 · snapshot · ZSTD"]
    CTJob["LXC JOB · 111 / 114<br/>Daily04:00 · snapshot · ZSTD<br/>Local temporary data: /var/tmp"]
    OMV["OMV · 192.168.40.50<br/>omv-backups NFS<br/>7 daily + 6 monthly generations"]
    Evidence["ACCEPTANCE STATUS<br/>Fresh guest-archive evidence pending<br/>Integrity and restore proof are separate"]
    Rollback["POWERED-OFF ROLLBACK ONLY<br/>VM101 old Frigate · VM104 old AI<br/>Never start alongside replacement CTs"]
    VMs --> VMJob --> OMV
    CTs --> CTJob --> OMV
    OMV --> Evidence
    Rollback ~~~ CTs
    class HA,Monitor,Docker,Frigate,AI core
    class VMJob,CTJob,OMV store
    class GPU,Evidence policy
    class Rollback deferred

    classDef core fill:#143747,stroke:#63c9bd,color:#eefbfa
    classDef store fill:#292745,stroke:#aa99db,color:#f2edff
    classDef policy fill:#2f301f,stroke:#c7bc77,color:#fff9d8
