  { "id":"ventsys-sla-temp","type":"inject","z":"ventsys-sla-tab","name":"Simulated Temp SLA","props":[{"p":"payload"}],"repeat":"5","crontab":"","once":true,"onceDelay":0.1,"payload":25,"payloadType":"num","x":180,"y":140,"wires":[["ventsys-sla-fire-risk"]] },
  { "id":"ventsys-sla-fire-risk","type":"function","z":"ventsys-sla-tab","name":"Fire Risk SLA","func":"let temp = Number(msg.payload)||0; let voc=120, humidity=45; let riskScore=temp*2+voc*1.5+humidity*0.5; if(riskScore>=1000){msg.level='FIRE_RISK';} else if(riskScore>=500){msg.level='URGENT';} else if(riskScore>=100){msg.level='WARNING';} else {msg.level='NORMAL';} return msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":140,"wires":[["ventsys-sla-adaptive-airflow","nr-risk-sla","ventsys-sla-dashboard-alert"]] },
  { "id":"ventsys-sla-adaptive-airflow","type":"function","z":"ventsys-sla-tab","name":"Adaptive Airflow SLA","func":"let pressureDiff=0; if(msg.level=='FIRE_RISK'){msg.valve=100;} else if(msg.level=='URGENT'){msg.valve=75;} else if(msg.level=='WARNING'){msg.valve=50;} else {msg.valve=25;} if(pressureDiff<-2){msg.valve=Math.min(100,msg.valve+10);} msg.payload=msg.valve; return msg;","outputs":1,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":200,"wires":[["ventsys-sla-valve","ventsys-sla-airflow-arrow","ventsys-sla-log","nr-valve-state-sla","sla-t-inlet","sla-t-down"]] },
