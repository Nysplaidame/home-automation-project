  { "id":"sla-press-loop-sp","type":"function","z":"ventsys-sla-tab","name":"Store SP","func":"let sp=Number(msg.payload); if(!isFinite(sp)) return null; flow.set('sla_sp_pa',sp); return null;","outputs":0,"noerr":0,"x":420,"y":400,"wires":[] },
  { "id":"sla-press-loop-en","type":"function","z":"ventsys-sla-tab","name":"Store Enable","func":"const v=String(msg.payload).toLowerCase(); const en=(v==='1'||v==='true'||v==='on'); flow.set('sla_loop_en',en); return null;","outputs":0,"noerr":0,"x":420,"y":440,"wires":[] },
  { "id":"sla-press-loop","type":"function","z":"ventsys-sla-tab","name":"SLA Pressure PID-lite","func":"const nowMs=Date.now(); const loopEn=flow.get('sla_loop_en')??true; if(!loopEn) return null; const sp=Number(flow.get('sla_sp_pa')??-10); const pv=Number(msg.payload); if(!isFinite(pv)) return null; const Kp=Number(flow.get('sla_kp')??3.0); const Ki=Number(flow.get('sla_ki')??0.8); const Kd=Number(flow.get('sla_kd')??0.0); const dt=1.0; const err=sp-pv; let integ=Number(flow.get('sla_integ')??0); let prevErr=Number(flow.get('sla_prev_err')??0); integ+=err*dt; const deriv=(err-prevErr)/dt; let u=Kp*err+Ki*integ+Kd*deriv; let base=Number(flow.get('sla_base_pct')??25); let valvePct=base+u; let saturated=false; if(valvePct>100){valvePct=100;saturated=true;} if(valvePct<0){valvePct=0;saturated=true;} if(saturated && err*integ>0){integ-=err*dt*0.5;} let lastOut=Number(flow.get('sla_last_valve')??base); const maxStep=10; if(valvePct>lastOut+maxStep) valvePct=lastOut+maxStep; if(valvePct<lastOut-maxStep) valvePct=lastOut-maxStep; let fanPct=valvePct>0?Math.max(30,Math.min(100,Math.round(valvePct))):0; flow.set('sla_integ',integ); flow.set('sla_prev_err',err); flow.set('sla_last_valve',valvePct); return [ {payload:Math.round(valvePct)}, {payload:Math.round(fanPct)} ];","outputs":2,"noerr":0,"initialize":"","finalize":"","libs":[],"x":420,"y":360,"wires":[["ventsys-sla-valve","nr-valve-state-sla"],["ventsys-fan-percent","ventsys-fan-percent-state"]] },

