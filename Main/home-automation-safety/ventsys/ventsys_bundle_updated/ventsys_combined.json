  { "id":"ventsys-system-tab","type":"tab","label":"VentSys - Branch 5 System Logic","disabled":false,"info":"System: device watchdog, fail-safe (triggered only on device silence), (optional) arbitration" },
  { "id":"ventsys-heartbeat","type":"inject","z":"ventsys-system-tab","name":"Watchdog Tick (10s)","props":[{"p":"payload"}],"repeat":"10","crontab":"","once":true,"onceDelay":30,"topic":"","payload":"tick","payloadType":"str","x":170,"y":140,"wires":[["ventsys-watchdog-check"]] },
  { "id":"ventsys-watchdog-check","type":"function","z":"ventsys-system-tab","name":"Device Watchdog","func":"// Check if devices have sent heartbeats recently. Fail-safe fires only on silence.\nconst now = Date.now();\nconst TIMEOUT_MS = 90000; // 90s — devices heartbeat every 60s\nconst fanLast = flow.get('last_heartbeat_fan') || 0;\nconst valveLast = flow.get('last_heartbeat_valve') || 0;\nconst fanSilent = (now - fanLast) > TIMEOUT_MS;\nconst valveSilent = (now - valveLast) > TIMEOUT_MS;\n// Only trigger fail-safe if a device has been silent AND system was previously running\nconst wasRunning = flow.get('ventsys_running') || false;\nif (wasRunning && (fanSilent || valveSilent)) {\n  node.warn('WATCHDOG: device silent >90s — triggering fail-safe. fan:'+fanSilent+' valve:'+valveSilent);\n  flow.set('ventsys_running', false);\n  return [null, {payload:'WATCHDOG_TRIGGERED', fanSilent, valveSilent}];\n}\nreturn [null, null];","outputs":2,"noerr":0,"initialize":"","finalize":"","libs":[],"x":380,"y":140,"wires":[[],["ventsys-failsafe"]] },
  { "id":"ventsys-heartbeat-fan-in","type":"mqtt in","z":"ventsys-system-tab","name":"Fan Heartbeat","topic":"ventsys/devices/espfan/heartbeat","qos":"0","datatype":"auto","broker":"ventsys-mqtt","nl":false,"rap":true,"rh":0,"x":170,"y":200,"wires":[["ventsys-hb-fan-store"]] },
  { "id":"ventsys-heartbeat-valve-in","type":"mqtt in","z":"ventsys-system-tab","name":"Valve Heartbeat","topic":"ventsys/devices/espvalve/heartbeat","qos":"0","datatype":"auto","broker":"ventsys-mqtt","nl":false,"rap":true,"rh":0,"x":170,"y":240,"wires":[["ventsys-hb-valve-store"]] },
  { "id":"ventsys-hb-fan-store","type":"function","z":"ventsys-system-tab","name":"Store Fan Heartbeat","func":"flow.set('last_heartbeat_fan', Date.now()); flow.set('ventsys_running', true); return null;","outputs":0,"noerr":0,"x":400,"y":200,"wires":[] },
  { "id":"ventsys-hb-valve-store","type":"function","z":"ventsys-system-tab","name":"Store Valve Heartbeat","func":"flow.set('last_heartbeat_valve', Date.now()); flow.set('ventsys_running', true); return null;","outputs":0,"noerr":0,"x":400,"y":240,"wires":[] },
  { "id":"ventsys-failsafe","type":"function","z":"ventsys-system-tab","name":"Fail-safe Override","func":"msg.payload=100; return [msg,msg,msg,{...msg,payload:'on'}];","outputs":4,"noerr":0,"initialize":"","finalize":"","libs":[],"x":380,"y":300,"wires":[["ventsys-sla-valve-ctl"],["ventsys-fdm-valve-ctl"],["ventsys-booth-valve-ctl"],["ventsys-fan-ctl","nr-fan-state"]] },
