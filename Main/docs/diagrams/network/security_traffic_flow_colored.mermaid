graph TD
    %% Internet and WAN
    INTERNET[Internet<br/>DNS: 1.1.1.1, 8.8.8.8]
    
    %% Router Firewall Core
    subgraph FIREWALL[Router Firewall Core]
        FW_ENGINE[Firewall Engine<br/>11 Security Zones<br/>60+ Active Rules]
    end
    
    %% Network Zones by Security Level
    subgraph FULL_ACCESS[Full Internet Access Zones]
        ZONE_LAN[LAN Zone<br/>192.168.1.0/24<br/>Main Users]
        ZONE_MGMT[Management Zone<br/>192.168.10.0/24<br/>Admin Access]
        ZONE_GUEST[Guest Zone<br/>192.168.99.0/24<br/>Visitor Access]
    end
    
    subgraph LIMITED_ACCESS[Limited Internet Access Zones]
        ZONE_AUTO[Automation Zone<br/>192.168.20.0/24<br/>HA VM Only]
        ZONE_MON[Monitoring Zone<br/>192.168.60.0/24<br/>Updates/Alerts]
        ZONE_DMZ[DMZ Zone<br/>192.168.70.0/24<br/>Controlled Access]
    end
    
    subgraph NO_ACCESS[No Internet Access - Isolated Zones]
        ZONE_CCTV[CCTV Zone<br/>192.168.30.0/24<br/>Air-Gapped]
        ZONE_STORAGE[Storage Zone<br/>192.168.40.0/24<br/>Air-Gapped]
        ZONE_IOT[IoT Sensors Zone<br/>192.168.50.0/24<br/>Air-Gapped]
    end
    
    subgraph VPN_ACCESS[VPN Remote Access]
        ZONE_VPN[VPN Clients Zone<br/>10.0.0.0/24<br/>Controlled Access]
    end
    
    %% Legend
    subgraph LEGEND[Traffic Flow Legend]
        LEG_INTERNET[Full Internet Access - Green]
        LEG_LIMITED[Limited Internet Access - Orange]
        LEG_BLOCKED[Blocked Internet Access - Red]
        LEG_ADMIN[Administrative Access - Blue]
        LEG_SERVICE[Service Communication - Purple]
        LEG_VPN[VPN Access - Cyan]
    end
    
    %% Internet Access Flows (Green for Full, Orange for Limited, Red for Blocked)
    INTERNET --> FW_ENGINE
    FW_ENGINE --> ZONE_LAN
    FW_ENGINE --> ZONE_MGMT
    FW_ENGINE --> ZONE_GUEST
    FW_ENGINE -.-> ZONE_AUTO
    FW_ENGINE -.-> ZONE_MON
    FW_ENGINE -.-> ZONE_DMZ
    
    %% Blocked Internet Access (Red)
    FW_ENGINE ==> ZONE_CCTV
    FW_ENGINE ==> ZONE_STORAGE
    FW_ENGINE ==> ZONE_IOT
    
    %% Administrative Access Flows (Blue)
    ZONE_MGMT --> ZONE_LAN
    ZONE_MGMT --> ZONE_AUTO
    ZONE_MGMT --> ZONE_CCTV
    ZONE_MGMT --> ZONE_STORAGE
    ZONE_MGMT --> ZONE_IOT
    ZONE_MGMT --> ZONE_MON
    ZONE_MGMT --> ZONE_DMZ
    
    %% Service Communication Flows (Purple)
    ZONE_AUTO ==> ZONE_IOT
    ZONE_AUTO ==> ZONE_CCTV
    ZONE_AUTO ==> ZONE_STORAGE
    ZONE_CCTV ==> ZONE_STORAGE
    ZONE_MON ==> ZONE_LAN
    ZONE_MON ==> ZONE_AUTO
    ZONE_MON ==> ZONE_CCTV
    
    %% VPN Access Controls (Cyan for Allowed, Red for Blocked)
    ZONE_VPN --> ZONE_LAN
    ZONE_VPN --> ZONE_AUTO
    ZONE_VPN --> ZONE_DMZ
    ZONE_VPN ==> ZONE_MGMT
    ZONE_VPN ==> ZONE_CCTV
    ZONE_VPN ==> ZONE_STORAGE
    ZONE_VPN ==> ZONE_IOT
    
    %% VentSys Critical Ports
    subgraph VENTSYS[VentSys Critical Communication]
        MQTT_8883[MQTT TLS Port 8883<br/>IoT to HA]
        ESPHOME_6053[ESPHome API Port 6053<br/>HA to IoT]
        HA_WEB_8123[HA Web UI Port 8123<br/>VPN to HA]
    end
    
    %% Link Styles - Color Coding
    %% Full Internet Access (Green)
    linkStyle 0,1,2,3 stroke:#4caf50,stroke-width:3px
    %% Limited Internet Access (Orange)
    linkStyle 4,5,6 stroke:#ff9800,stroke-width:2px,stroke-dasharray: 5 5
    %% Blocked Internet Access (Red)
    linkStyle 7,8,9 stroke:#f44336,stroke-width:3px,stroke-dasharray: 10 5
    %% Administrative Access (Blue)
    linkStyle 10,11,12,13,14,15,16 stroke:#2196f3,stroke-width:2px
    %% Service Communication (Purple)
    linkStyle 17,18,19,20,21,22,23 stroke:#9c27b0,stroke-width:2px
    %% VPN Access Allowed (Cyan)
    linkStyle 24,25,26 stroke:#00bcd4,stroke-width:2px
    %% VPN Access Blocked (Red)
    linkStyle 27,28,29,30 stroke:#f44336,stroke-width:2px,stroke-dasharray: 5 5
    
    %% Styling
    classDef fullAccess fill:#c8e6c9,stroke:#4caf50,stroke-width:2px
    classDef limitedAccess fill:#fff3e0,stroke:#ff9800,stroke-width:2px
    classDef noAccess fill:#ffcdd2,stroke:#f44336,stroke-width:2px
    classDef vpnAccess fill:#e0f2f1,stroke:#00bcd4,stroke-width:2px
    classDef firewallStyle fill:#e8eaf6,stroke:#3f51b5,stroke-width:3px
    classDef ventsysStyle fill:#fff8e1,stroke:#f57c00,stroke-width:2px
    classDef legendStyle fill:#f5f5f5,stroke:#666666,stroke-width:1px
    
    class FULL_ACCESS,ZONE_LAN,ZONE_MGMT,ZONE_GUEST fullAccess
    class LIMITED_ACCESS,ZONE_AUTO,ZONE_MON,ZONE_DMZ limitedAccess
    class NO_ACCESS,ZONE_CCTV,ZONE_STORAGE,ZONE_IOT noAccess
    class VPN_ACCESS,ZONE_VPN vpnAccess
    class FIREWALL,FW_ENGINE firewallStyle
    class VENTSYS,MQTT_8883,ESPHOME_6053,HA_WEB_8123 ventsysStyle
    class LEGEND,LEG_INTERNET,LEG_LIMITED,LEG_BLOCKED,LEG_ADMIN,LEG_SERVICE,LEG_VPN legendStyle