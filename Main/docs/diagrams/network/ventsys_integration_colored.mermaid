graph TD
    %% VentSys Network Foundation
    subgraph FOUNDATION[VentSys Network Foundation]
        HA_VM[Home Assistant VM<br/>192.168.20.101<br/>VLAN 20 - Automation<br/>Central Control Hub]
        IOT_GW[IoT Gateway<br/>192.168.50.1<br/>VLAN 50 - IoT Sensors<br/>Local DNS Only - No Internet]
    end
    
    %% VentSys Device Ecosystem
    subgraph DEVICE_ECOSYSTEM[VentSys Device Ecosystem - 192.168.50.0/24]
        
        subgraph CONTROLLERS[System Controllers]
            FAN_CTRL[Fan Controller<br/>192.168.50.81<br/>Inline Exhaust Control<br/>Variable Speed]
            VALVE_CTRL[Valve Controller<br/>192.168.50.82<br/>Multi-Zone Dampers<br/>Position Feedback]
        end
        
        subgraph SENSORS[Environmental Sensors]
            TEMP_SENSORS[Temperature Sensors<br/>192.168.50.31-39<br/>SLA/FDM/Booth Zones<br/>Precision Monitoring]
            SMOKE_SENSORS[Smoke Detectors<br/>192.168.50.41-49<br/>Fire Safety Critical<br/>Rapid Response]
            VOC_SENSORS[VOC Sensors<br/>192.168.50.51-59<br/>Air Quality Monitor<br/>Chemical Detection]
            PRESSURE_SENSORS[Pressure Sensors<br/>192.168.50.61-69<br/>Differential Pressure<br/>Enclosure Monitoring]
        end
        
        subgraph SAFETY[Safety Control Systems]
            SMART_PLUGS[Smart Plugs<br/>192.168.50.71-79<br/>Emergency Shutoff<br/>Printer Power Control]
            SERVO_MOTORS[Servo Controllers<br/>192.168.50.83-89<br/>Precision Positioning<br/>Valve Actuators]
        end
    end
    
    %% WiFi Infrastructure
    subgraph WIFI_INFRA[WiFi Infrastructure for VentSys]
        HOMEIOT_SSID[HomeIoT SSID<br/>2.4GHz Channel 6<br/>WPA2 for Compatibility<br/>Client Isolation Enabled]
    end
    
    %% Legend
    subgraph LEGEND[Connection Legend]
        LEG_WIFI[WiFi Device Connections - Green]
        LEG_BRIDGE[HA VM Bridge Access - Blue]
        LEG_MQTT[MQTT Data Flow - Orange]
        LEG_ESPHOME[ESPHome Control Flow - Purple]
        LEG_BLOCKED[Blocked Connections - Red]
        LEG_EMERGENCY[Emergency Safety - Magenta]
    end
    
    %% WiFi Device Connections (Green)
    HOMEIOT_SSID --> IOT_GW
    IOT_GW --> FAN_CTRL
    IOT_GW --> VALVE_CTRL
    IOT_GW --> TEMP_SENSORS
    IOT_GW --> SMOKE_SENSORS
    IOT_GW --> VOC_SENSORS
    IOT_GW --> PRESSURE_SENSORS
    IOT_GW --> SMART_PLUGS
    IOT_GW --> SERVO_MOTORS
    
    %% HA VM Bridge Connection (Blue)
    HA_VM -.-> IOT_GW
    
    %% MQTT Data Flows (Orange) - Sensors to HA
    TEMP_SENSORS ==> HA_VM
    SMOKE_SENSORS ==> HA_VM
    VOC_SENSORS ==> HA_VM
    PRESSURE_SENSORS ==> HA_VM
    
    %% ESPHome Control Flows (Purple) - HA to Controllers
    HA_VM --> FAN_CTRL
    HA_VM --> VALVE_CTRL
    HA_VM --> SMART_PLUGS
    HA_VM --> SERVO_MOTORS
    
    %% Safety Critical Blocked Connections (Red)
    subgraph BLOCKED[Blocked Connections - Safety Critical]
        INTERNET_BLOCK[Internet Access<br/>BLOCKED]
        DNS_BLOCK[External DNS<br/>BLOCKED] 
        DEVICE_ISOLATION_BLOCK[Device-to-Device<br/>BLOCKED]
    end
    
    IOT_GW -.-> INTERNET_BLOCK
    IOT_GW -.-> DNS_BLOCK
    DEVICE_ECOSYSTEM -.-> DEVICE_ISOLATION_BLOCK
    
    %% Emergency Safety Connections (Magenta)
    subgraph EMERGENCY[Emergency Safety Features]
        EMERGENCY_SHUTOFF[Emergency Shutoff<br/>Immediate Response]
        FAILSAFE_MODE[Failsafe Mode<br/>Autonomous Operation]
    end
    
    SMART_PLUGS ==> EMERGENCY_SHUTOFF
    SMOKE_SENSORS ==> EMERGENCY_SHUTOFF
    HA_VM ==> FAILSAFE_MODE
    
    %% Implementation Status
    subgraph STATUS[Network Prerequisites Status]
        NETWORK_READY[Network Foundation<br/>COMPLETE<br/>VLANs 20 & 50 Operational]
        FIREWALL_READY[Firewall Rules<br/>COMPLETE<br/>MQTT/ESPHome Ports Open]
        WIFI_READY[HomeIoT WiFi<br/>COMPLETE<br/>Broadcasting Channel 6]
        CA_READY[Certificate Infrastructure<br/>PREPARED<br/>Ready for TLS Setup]
    end
    
    %% VentSys Communication Protocols
    subgraph PROTOCOLS[Communication Protocols]
        MQTT_PROTO[MQTT TLS Port 8883<br/>Sensor Data Upload<br/>Device Status Reports]
        ESPHOME_PROTO[ESPHome API Port 6053<br/>Device Configuration<br/>Control Commands]
        NODERED_PROTO[Node-RED Orchestration<br/>Safety Logic<br/>PID Control Loops]
    end
    
    %% Link Styles - Color Coding
    %% WiFi Connections (Green)
    linkStyle 0,1,2,3,4,5,6,7,8 stroke:#4caf50,stroke-width:2px
    %% HA VM Bridge (Blue)
    linkStyle 9 stroke:#2196f3,stroke-width:3px,stroke-dasharray: 5 5
    %% MQTT Data Flows (Orange)
    linkStyle 10,11,12,13 stroke:#ff9800,stroke-width:3px
    %% ESPHome Control Flows (Purple)
    linkStyle 14,15,16,17 stroke:#9c27b0,stroke-width:3px
    %% Blocked Connections (Red)
    linkStyle 18,19,20 stroke:#f44336,stroke-width:2px,stroke-dasharray: 10 5
    %% Emergency Safety (Magenta)
    linkStyle 21,22,23 stroke:#e91e63,stroke-width:4px
    
    %% Styling
    classDef foundationStyle fill:#fff3e0,stroke:#f57c00,stroke-width:3px
    classDef deviceStyle fill:#e8f5e8,stroke:#4caf50,stroke-width:2px
    classDef securityStyle fill:#ffebee,stroke:#f44336,stroke-width:2px
    classDef statusStyle fill:#e8eaf6,stroke:#3f51b5,stroke-width:2px
    classDef emergencyStyle fill:#fce4ec,stroke:#e91e63,stroke-width:3px
    classDef protocolStyle fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px
    classDef legendStyle fill:#f5f5f5,stroke:#666666,stroke-width:1px
    
    